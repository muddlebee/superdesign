{
  "name": "superdesign-mcp",
  "version": "0.1.0",
  "description": "MCP server: Superdesign canvas in the browser + design file tools for Codex / Claude Code",
  "type": "module",
  "bin": {
    "superdesign-mcp": "./dist/server.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
