    "ws": "^8.18.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
